# URL da API backend
NEXT_PUBLIC_API_URL=http://localhost:3101

# Facebook App ID (para OAuth)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Configuração de criptografia (default key)
NEXT_PUBLIC_DEFAULT_ENCRYPTION_KEY=zpro-passaporte-2024-encryption-key

# Habilita opções interativas Baileys (quick reply, lista, CTA, menu, enquete, catálogo, carrossel)
NEXT_PUBLIC_INTERACTIVE_BAILEYS=false

# (Opcional) URL do OAuth Proxy centralizado do vendor.
# Quando definido, os fluxos de OAuth Meta (Facebook, Instagram, WhatsApp)
# usam o proxy como redirect_uri em vez do domínio local da instalação.
# Isso permite instalações self-hosted sem precisar registrar cada domínio no app Meta.
# Ex: https://oauth.seudominio.com
# Deixe vazio para usar o comportamento padrão (redirect direto pelo domínio local).
NEXT_PUBLIC_OAUTH_PROXY_URL=
