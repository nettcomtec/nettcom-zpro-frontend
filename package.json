    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS='--max-old-space-size=3072' next build && npm run copy-public",
    "copy-public": "mkdir -p .next/standalone/public && mkdir -p .next/standalone/.next && cp -r public/* .next/standalone/public/ && cp -r .next/static .next/standalone/.next/static",
    "deploy": "npm run build && npm run copy-public",
    "start": "dotenv -e .env.local -- next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
